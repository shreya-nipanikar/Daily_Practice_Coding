package com.corejava.exceptionhandling;

public class InvalidAccount extends Exception {
	
	
	public InvalidAccount(String message) {
		super(message);
	}
	
}

class Accnumber {
	
	public void validAccount(int accNumber) throws InvalidAccount
	{
		if(accNumber <= 12) {
			throw new InvalidAccount("Your account number must be 12digits");
			
		} else {
			System.out.println("Your account number is prefect");
		}
		
		
	}
	
	
}