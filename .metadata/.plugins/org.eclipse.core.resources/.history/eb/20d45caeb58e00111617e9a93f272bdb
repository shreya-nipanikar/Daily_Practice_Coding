package com.insurance.InsurancePolicy.controller;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.insurance.InsurancePolicy.entity.InsurancePolicy;
import com.insurance.InsurancePolicy.service.InsuranceService;

@RestController
@RequestMapping("/policy")
public class InsuranceController {
	
	@Autowired
	InsuranceService service;
	
	@GetMapping("/all")
	public List<InsurancePolicy> getDeatils(){
		return service.getAllDetails();
	}
	
	@GetMapping("/{id}")
	public InsurancePolicy getDetailsById(@PathVariable Long id) {
		return service.getById(id);
	}
	

}
