package com.corejava.exceptionhandling;

public class PolicyAge extends Exception{

	public PolicyAge(String message) {
		super(message);
	}

}



class AgeValidation {
	
	public void Valid(int age) throws PolicyAge {
		
		if(age < 0) {
			System.out.println("Age cannot be negative!");
		}
		
		System.out.println("Prefect");
	}
	
	
	
}
