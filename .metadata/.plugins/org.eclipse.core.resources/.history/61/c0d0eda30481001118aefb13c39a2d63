package com.corejava.stringwrapper;

import java.util.Scanner;

public class Insurance {

	public static void main(String[] args) {
		
		Scanner sc = new Scanner(System.in);
		
		System.out.println("Enter policy description: ");
		String policy = sc.nextLine();
		
		//Count total number of characters. 
		System.out.println("Character count : "+policy.length());
		System.out.println("Word count: "+policy.trim().split("\\s+").length);
		
		
		
		

	}

}
