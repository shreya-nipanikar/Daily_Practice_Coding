package com.insurance.InsurancePolicy.service;

import java.util.List;

import javax.management.RuntimeErrorException;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.insurance.InsurancePolicy.entity.InsurancePolicy;
import com.insurance.InsurancePolicy.repository.InsurancePolicyRepo;


@Service
public class InsuranceService {
	
	@Autowired
	InsurancePolicyRepo Repo;
	
	//Get All Policies
	public List<InsurancePolicy> getAllDetails(){
		return Repo.findAll();
	}
	
	//Get Policy By Id
	public InsurancePolicy getById(Long id) {
		return Repo.findById(id).orElse(null);
	}
	
	//Save ALL Policy
	public List<InsurancePolicy> SaveAllPolicy(List<InsurancePolicy> policies){
		
		for(InsurancePolicy policy: policies) {
			if(policy.getEndDate().isBefore(policy.getStartDate())) {
				throw new RuntimeException("End date must not be before start date");
			}
		}
		
		return Repo.saveAll(policies);
	}
	
	
	//Update Policy
	public InsurancePolicy UpdatePolicyById(InsurancePolicy policy) {
		return Repo.save(policy);
	}
	
	//Delete By Id
	public String DeleteById(Long id) {
		 Repo.deleteById(id);
		 return "Successfully Deleted the Record!";
	}
	
	//Delete All
	public String DeleteAll() {
		Repo.deleteAll();
		return "All Records Successfully deleted!";
	}

}
